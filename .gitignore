# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Testing
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# PyInstaller
*.spec
!pickhero.spec
PickHero.exe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Private planning docs
PROJECT.md

# AI/development config
.claude/
.mcp/

# Songs directory content (GP files are large, user-specific)
songs/*.gp3
songs/*.gp4
songs/*.gp5
songs/*.gpx
songs/*.gp
# ...and the recording that sits beside the tab, which is the same song and
# the same copyright. Only half of this rule was written down, so a backing
# track picked with Shift+U landed in `git status` as an untracked file and
# would eventually have been committed by whoever was tidying up.
songs/*.mp3
songs/*.ogg
songs/*.wav
songs/*.m4a
songs/*.flac
!songs/.gitkeep
# ...but the generated diagnostic tabs are fixtures rather than
# somebody's music, and tools/ does not exist inside the EXE.
!songs/power_chord_test_*.gp5

# Temp files
tmp/

# User config
pickhero_config.json

# The build stamp is generated by build.bat for the EXE it is making,
# so it describes one machine's build and never belongs in the tree.
pickhero/_build_stamp.txt

# ffmpeg, fetched by tools/fetch_ffmpeg.py for the build. 80 MB of binary
# that belongs in the .exe and not in the history -- a 6 MB MP3 got in here
# once already.
tools/ffmpeg
tools/ffmpeg.exe

# What the app writes beside each tab: the bar map it caches, the song's
# own settings, and every run of it -- all three travel with the songs
# folder and none of them belongs in the history. The runs are one
# character per note of somebody's playing; the player asked for his songs
# to move between machines "ohne History", and a repository is the one
# place that is not a machine.
*.songsterr.json
*.mysician.json
*.runs.json
