# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Testing
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# PyInstaller
*.spec
!pickhero.spec
PickHero.exe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Private planning docs
PROJECT.md

# AI/development config
.claude/
.mcp/

# Songs directory content (GP files are large, user-specific)
songs/*.gp3
songs/*.gp4
songs/*.gp5
songs/*.gpx
songs/*.gp
# ...and the recording that sits beside the tab, which is the same song and
# the same copyright. Only half of this rule was written down, so a backing
# track picked with Shift+U landed in `git status` as an untracked file and
# would eventually have been committed by whoever was tidying up.
songs/*.mp3
songs/*.ogg
songs/*.wav
songs/*.m4a
songs/*.flac
!songs/.gitkeep

# Temp files
tmp/

# User config
pickhero_config.json

# The build stamp is generated by build.bat for the EXE it is making,
# so it describes one machine's build and never belongs in the tree.
pickhero/_build_stamp.txt
